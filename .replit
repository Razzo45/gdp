entrypoint = "src/app/page.tsx"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
# Autoscale is fine for the web tier; the embedded worker runs in the same
# process (RUN_WORKER=1). For a dedicated worker use a Reserved VM and run
# `npm run worker` with RUN_WORKER=0 on the web deployment.
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build && npm run db:migrate"]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 80

[env]
PORT = "3000"
NEXT_TELEMETRY_DISABLED = "1"
# Use the existing Replit Supabase project (Auth + private Storage + CORS).
# DATABASE_URL must stay the Neon/app.* URL — never the live GDP Postgres.
STORAGE_DRIVER = "supabase"
RUN_WORKER = "1"

[workflows]
runButton = "Dev"

[[workflows.workflow]]
name = "Dev"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Tests"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test"
