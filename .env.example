# Fill these. See CONNECT.md. Never bake this file into the image.

# 1. Database — RDS / Aurora Postgres 16+. App owns schema app.* only.
DATABASE_URL=
DATABASE_POOL_MAX=10

# 2. Auth — existing Supabase project (identity only), or AUTH_MODE=local.
AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
BOOTSTRAP_ADMIN_EMAILS=
AUTH_LOCAL_SECRET=
AUTH_LOCAL_PASSWORD=

# 3. Files — private S3. Task role is enough; keys only if there is no role.
STORAGE_DRIVER=s3
STORAGE_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_LOCAL_DIR=tmp/storage

# 4. Mail — SES. Same live template. Skip by leaving SES_FROM_EMAIL empty.
SES_FROM_EMAIL=
SES_ASSIGNMENT_TEMPLATE=submission_assigned

# 5. Model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FACTORY_MODEL=
GEMINI_CONCURRENCY=96
GEMINI_CONCURRENCY_FLOOR=16
GEMINI_CONCURRENCY_INITIAL=96
GEMINI_OWNER_CONCURRENCY=96
GEMINI_INCREASE_AFTER=4
GEMINI_FILES_CONCURRENCY=8
GEMINI_TIMEOUT_MS=180000
GEMINI_MOCK=0
AUTORATE_BATCH_SIZE=10

# 6. Catalog
WIRESTOCK_API_BASE_URL=https://api.wirestock.io/data-program/core
WIRESTOCK_API_TOKEN=
WIRESTOCK_WEBHOOK_SECRET=

# 7. Public origin (invite / reset / assignment-mail links)
PUBLIC_APP_URL=

# Runtime
RUN_WORKER=1
WORKER_CONCURRENCY=2
LIBREOFFICE_BIN=/usr/bin/soffice
