# Fill these. See CONNECT.md. Never bake this file into the image.

# 1. Database — any Postgres 16+. App owns schema app.* only.
DATABASE_URL=
DATABASE_POOL_MAX=10

# 2. Auth — Supabase project, or AUTH_MODE=local for a closed box.
AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
BOOTSTRAP_ADMIN_EMAILS=
AUTH_LOCAL_SECRET=
AUTH_LOCAL_PASSWORD=

# 3. Files — gcs | supabase | local. local is not for hosting.
STORAGE_DRIVER=
STORAGE_BUCKET=
STORAGE_LOCAL_DIR=tmp/storage

# 4. Model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FACTORY_MODEL=
GEMINI_CONCURRENCY=96
GEMINI_CONCURRENCY_FLOOR=16
GEMINI_CONCURRENCY_INITIAL=96
GEMINI_OWNER_CONCURRENCY=96
GEMINI_INCREASE_AFTER=4
GEMINI_FILES_CONCURRENCY=8
GEMINI_TIMEOUT_MS=180000
GEMINI_MOCK=0
AUTORATE_BATCH_SIZE=10

# 5. Catalog
WIRESTOCK_API_BASE_URL=https://api.wirestock.io/data-program/core
WIRESTOCK_API_TOKEN=
WIRESTOCK_WEBHOOK_SECRET=

# 6. Public origin (invite / reset links)
PUBLIC_APP_URL=

# Runtime
RUN_WORKER=1
WORKER_CONCURRENCY=2
LIBREOFFICE_BIN=/usr/bin/soffice
