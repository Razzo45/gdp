# ── Identity ─────────────────────────────────────────────────────────────────
# supabase (production) or local (development: seeded users, shared password,
# no Supabase project needed — see README "Local development without Supabase").
AUTH_MODE=supabase
AUTH_LOCAL_SECRET=change-me-when-using-local-mode
AUTH_LOCAL_PASSWORD=gdp-dev

# ── Supabase (identity + Postgres + private storage) ─────────────────────────
# Required when AUTH_MODE=supabase. Publishable/anon key is preferred.
# If those are unset, the server uses SUPABASE_READ_URL + SUPABASE_READ_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Without it: no invites, and STORAGE_DRIVER falls back to local.
SUPABASE_SERVICE_ROLE_KEY=
# HS256 projects only (Project Settings → API → JWT Secret). Leave empty on
# projects that use asymmetric signing keys; JWKS is used instead.
SUPABASE_JWT_SECRET=
# Use the *transaction* pooler URL (port 6543). Prepared statements are off.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=10
# Optional. Live project, reads only (`npm run db:snapshot-supabase`).
# Prefer the Replit secrets (no database password, do not reset it):
# SUPABASE_READ_URL=https://xxxx.supabase.co
# SUPABASE_READ_SERVICE_ROLE_KEY=
# SUPABASE_READ_DATABASE_URL is a fallback if you already have the Postgres URI.
# Private bucket for AI outputs and rendered PDFs. Created on first use if
# the service role may create buckets; otherwise create it by hand (private).
STORAGE_BUCKET=gdp-private
# gcs (Cloud Run + ADC) | supabase | local. Defaults to supabase when a
# service key is set, else local. Do not set gcs until a bucket exists.
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=tmp/storage

# ── Gemini (AI Studio) ───────────────────────────────────────────────────────
# Google AI Studio key (AIza… or newer AQ.… auth keys). Not an OpenAI sk-… key.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional stronger model for the rubric factory; defaults to GEMINI_MODEL.
GEMINI_FACTORY_MODEL=
# Adaptive admission for a Tier 3 key on a FIFO queue (one heavy user).
# Google does not publish RPM/TPM anymore — check AI Studio. The published
# hard cap is $200 / 10 min. Start at the ceiling; 429s still halt + halve
# and climb back. OWNER matches CONCURRENCY so one generation can saturate.
GEMINI_CONCURRENCY=96
GEMINI_CONCURRENCY_FLOOR=16
GEMINI_CONCURRENCY_INITIAL=96
GEMINI_OWNER_CONCURRENCY=96
GEMINI_INCREASE_AFTER=4
# Files API uploads have their own lane.
GEMINI_FILES_CONCURRENCY=8
GEMINI_TIMEOUT_MS=180000
# Dev: send the real body, treat a free-tier 429 as landed, stand in the JSON.
GEMINI_MOCK=0
# Statements graded per request (same output file, same scope). 10 keeps
# evidence quality high; raise to 15–20 for short rubrics.
AUTORATE_BATCH_SIZE=10

# ── Catalog (Wirestock data-program core) ────────────────────────────────────
# For local development point this at the mock: http://localhost:4010 with any
# non-empty token and WIRESTOCK_WEBHOOK_SECRET=local-webhook-secret.
WIRESTOCK_API_BASE_URL=https://api.wirestock.io/data-program/core
WIRESTOCK_API_TOKEN=
# Shared secret for x-wirestock-signature (raw or base64).
WIRESTOCK_WEBHOOK_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────
# First sign-in by these emails grants the admin role automatically.
BOOTSTRAP_ADMIN_EMAILS=you@company.com
# Public origin used in invite / password-reset links.
PUBLIC_APP_URL=https://gdp.yourteam.repl.co
# 1 = run the job worker inside the web process (Replit / local default).
# 0 = web only; run `npm run worker` (Cloud Run worker service).
RUN_WORKER=1
WORKER_CONCURRENCY=2
# Path to soffice; auto-detected on PATH when unset. Without it Office files
# are graded from their OOXML manifest + text digest (no visual render).
LIBREOFFICE_BIN=
